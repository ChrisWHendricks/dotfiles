    #
    # STAGE & COMMIT HELPERS
    #

    # Stage all changes and commit with conventional commit format
    cam = "!f() { \
        git add -A && \
        ticket=$(git get-ticket-id); \
        if [ -n \"$3\" ]; then \
            if [ -n \"$ticket\" ]; then \
                git commit -m \"$ticket: $1($2): $3\"; \
            else \
                git commit -m \"$1($2): $3\"; \
            fi; \
        else \
            if [ -n \"$ticket\" ]; then \
                git commit -m \"$ticket: $1: $2\"; \
            else \
                git commit -m \"$1: $2\"; \
            fi; \
        fi; \
    }; f"
